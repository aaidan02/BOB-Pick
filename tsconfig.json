{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "allowJs": true, "checkJs": false, "noEmit": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["web/src/**/*.ts", "supabase/functions/_shared/**/*.ts", "vite.config.ts"]
}
